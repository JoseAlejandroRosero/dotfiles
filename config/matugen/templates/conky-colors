    default_outline_color = '{{colors.outline.default.hex}}',
    default_shade_color = '{{colors.shadow.default.hex}}',
    color1 = '{{colors.primary_container.default.hex}}',
    color2 = '{{colors.source_color.default.hex}}',
    color3 = '{{colors.secondary_container.default.hex}}',
    color4 = '{{colors.primary_container.default.hex}}',
    color5 = '{{colors.tertiary_container.default.hex}}',
    double_buffer = true,
    draw_borders = false,
    draw_graph_borders = true,
