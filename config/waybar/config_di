{
  "layer": "bot",
  "spacing": 0,
  "height": 0,
  "margin-bottom": 0,
  "margin-top": 4,
  "position": "top",
  "reload_style_on_change": true,
  "modules-center": [
    "custom/power",
    "dwl/tags",
    "wireplumber",
    "clock",
    "tray"
  ],
  "custom/power": {
    "format" : "⏼",
    "tooltip-format": "Power menu",
	"on-click": "wlogout"
  },
  "custom/hexecute" : {
    "format": " 󱄧 ",
    "tooltip-format": "hexecute",
    "on-click": "hexecute"
  },
  "dwl/tags": {
    "num-tags": 9,
    "tag-labels": ["", "", "󰓓", "", "", "󰥔", "", "", ""],
    "expand": true
  },
  "dwl/window": {
    "format": "[{layout}]{app_id}",
    "on-click": "mmsg -d toggleoverview",
    "on-click-middle": "mmsg -d togglefloating",
    "on-click-right": "mmsg -d killclient",
    "swap-icon-label": false,
    "max-length": 50,
    "rewrite": {
      "librewolf": "🌎 $1",
    },
  },
  "mpd" : {
    "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon} {artist} - {filename}",
    "format-disconnected": "Disconnected 󱘖 ",
    "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon} Stopped",
    "artist-len": 6,
    "title-len": 20,
    "consume-icons": {"on": " "},
    "random-icons": {"on": " "},
    "repeat-icons": {"on": " "},
    "single-icons": {"on": "󰲠 "},
    "state-icons": {
      "paused": " ",
      "playing": " "
      },
    "on-click": "ydotool key 125:1 25:1 125:0 25:0",
    "on-click-middle": "mpc toggle",
    "on-scroll-up": "mpc prev",
    "on-scroll-down": "mpc next",
  },
  "group/rightmenu": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "click-to-reveal": true 
    },
    "modules": [
      "memory",
      "cpu",
      "disk",
      "temperature",
      "battery",
    ]
  },
  "tray": {
    "spacing": 10,
    "show-passive-items": true
  },
  "clock": {
    "format": "󰅐 {:%H:%M}",
    "tooltip-format": "<tt><span>{calendar}</span></tt>",
    "format-alt": " {:%x}",
    "timezone": "America/Bogota",
    "calendar": {
      "mode": "month",
      "mode-mon-col"  : 4,
      "on-scroll"     : 1,
      "on-click-right": "mode",
      "format": {
        "months":     "<span ><b>{}</b></span>",
        "days":       "<span ><b>{}</b></span>",
        "weekdays":   "<span ><b>{}</b></span>",
        "today":      "<span color='#000'><b>{}</b></span>"
        }
      },
      "actions": {
        "on-click-right": "mode",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
        }
  },
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": [
      "",
      "",
      ""
    ],
    "on-click": "ydotool key 125:1 40:1 125:0 40:0",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄{capacity}%",
    "format-alt": "{icon} {time}",
    "format-full": "󱈑 {capacity}%",
    "on-click": "btop",
    "format-icons": [
      "󱊡",
      "󱊢",
      "󱊣"
    ]
  }, 
  "memory": {
    "interval": 30,
    "format": "{used:0.1f}G/{total:0.1f}G {icon}",
    "max-length": 15,
    "states": {
      "warning": 70,
      "critical": 80,
    },
    "format-icons": [
      "",
      " "
    ]
  },
  "bluetooth": {
      "format": "󰂯 {status}",
      "format-connected": "󰂯 {device_alias}",
      "format-disabled": "󰂲",
      "on-click": "ydotool key 125:1 39:1 125:0 39:0",
      "on-click-middle": "rfkill toggle bluetooth",
      "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
      "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
  },
  "cpu": {
    "interval": 3,
    "on-click": "ydotool key 125:1 53:1 125:0 53:0",
    "format": "{icon0} {icon1} {icon3} {icon4} {usage:>2}% ",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
  },
  "disk": {
    "interval": 30,
    "path": "/home",
    "format": "󰋊 {percentage_used}% on {path}",
  },
  "temperature": {
    "interval": 30,
    "thermal-zone": 2, 
    "hwmon-path": [
      "/sys/class/hwmon/hwmon1/temp1_input",
      "/sys/class/hwmon/hwmon3/temp1_input",
    ],
    "warning-threshold": 75,
    "critical-threshold": 90,
    "format": "{temperatureC} °C ",
    "format-warning": "{temperatureC} °C ",
    "format-critical": "{temperatureC} °C ",
  },
}
